; EXAMPLE — SIP trunk template for routing a real phone number to Hermes.
;
; Unlike pjsip.conf (which is a working config for the OBi200), this is a
; TEMPLATE: every VoIP/ITSP provider names things differently, and inbound
; trunk auth is either registration-based (you register TO the provider,
; common for residential/small-business VoIP) or static-IP-based (the
; provider whitelists Asterisk's IP and sends INVITEs directly, common for
; carrier-grade trunks like Twilio Elastic SIP Trunking). Fill in the
; bracketed placeholders for YOUR provider, then append the relevant section
; to pjsip.conf and the dialplan block below to extensions.conf.
;
; Once a call from the trunk hits Stasis(hermes), it is indistinguishable
; from an OBi200 call — same adapter, same VAD/STT/TTS pipeline. The
; SIP_ALLOWED_USERS allowlist (caller ID) still applies, so an open trunk
; doesn't mean open access to Hermes.

; ── Option A: registration-based trunk (you register TO the provider) ──────
[trunk-transport]
type = transport
protocol = udp
bind = 0.0.0.0:5060

[my-provider]                         ; <-- pick any name
type = registration
outbound_auth = my-provider-auth
server_uri = sip:sip.my-provider.example        ; <-- provider's SIP server
client_uri = sip:MY_DID_NUMBER@sip.my-provider.example  ; <-- your number/account
retry_interval = 60

[my-provider-auth]
type = auth
auth_type = userpass
username = MY_ITSP_USERNAME           ; <-- from your provider
password = MY_ITSP_PASSWORD           ; <-- from your provider

[my-provider]
type = aor
contact = sip:sip.my-provider.example
qualify_frequency = 30

[my-provider]
type = endpoint
context = from-trunk                  ; <-- routes into Stasis, see below
disallow = all
allow = ulaw
allow = alaw
outbound_auth = my-provider-auth
aors = my-provider
from_user = MY_DID_NUMBER

; ── voip.ms (concrete example of Option A) ──────────────────────────────────
; voip.ms is the common case for exactly this project: a home Asterisk box
; behind NAT/dynamic IP, using a "Sub Account" (their name for registration-
; based auth — matches Option A above, NOT their IP Authentication method,
; which needs a static public IP you'd have to register in their portal).
;
; Setup on the voip.ms side (portal.voip.ms):
;   1. Main Menu -> Sub Accounts -> Create Sub Account. Note the generated
;      username (looks like "100000_hermes") and set a password.
;   2. Main Menu -> DID Numbers -> your number -> Edit -> set routing to
;      "Sub Account" -> pick the sub account you just created. This is the
;      step that actually delivers inbound calls to Asterisk instead of
;      voicemail/forwarding.
;   3. Pick the POP (server) closest to you from voip.ms's server list
;      (Account -> Server list) — e.g. "chicago4.voip.ms", "atlanta4.voip.ms",
;      "montreal4.voip.ms". Latency matters for a live conversation, so don't
;      just use the first one alphabetically.
;
[trunk-transport]
type = transport
protocol = udp
bind = 0.0.0.0:5060

[voipms]
type = registration
outbound_auth = voipms-auth
server_uri = sip:SERVER_POP.voip.ms          ; <-- e.g. sip:chicago4.voip.ms
client_uri = sip:SUBACCOUNT_USERNAME@SERVER_POP.voip.ms
retry_interval = 60
expiration = 3600

[voipms-auth]
type = auth
auth_type = userpass
username = SUBACCOUNT_USERNAME                ; <-- e.g. 100000_hermes
password = SUBACCOUNT_PASSWORD

[voipms]
type = aor
contact = sip:SERVER_POP.voip.ms
qualify_frequency = 30

[voipms]
type = endpoint
context = from-trunk                          ; <-- routes into Stasis, see below
disallow = all
allow = ulaw                                  ; voip.ms supports ulaw/alaw/g729;
allow = alaw                                   ; ulaw needs no extra codec license
outbound_auth = voipms-auth
aors = voipms
from_user = SUBACCOUNT_USERNAME
; voip.ms sends the caller's number in the From/P-Asserted-Identity headers;
; no special DTMF config is needed (RFC 4733 is the default and matches
; voip.ms). If Caller ID doesn't populate CALLERID(num) for SIP_ALLOWED_USERS
; filtering, add: dtmf_mode = rfc4733

; ── Option B: static-IP trunk (provider sends INVITEs directly, e.g. Twilio) ─
; Uncomment and adapt if your provider doesn't use registration.
;
; [trunk-transport]
; type = transport
; protocol = udp
; bind = 0.0.0.0:5060
;
; [twilio-identify]
; type = identify
; endpoint = twilio
; match = PROVIDER_SIP_IP_OR_CIDR      ; <-- e.g. Twilio's published signaling IPs
;
; [twilio]
; type = aor
; contact = sip:PROVIDER_SIP_IP_OR_CIDR
;
; [twilio]
; type = endpoint
; context = from-trunk
; disallow = all
; allow = ulaw
; aors = twilio

; ── Dialplan: route the trunk's inbound calls into Hermes ──────────────────
; Append to extensions.conf (alongside the existing [hermes-inbound]).
; ${EXTEN} is the dialed DID; route it (or all DIDs) into the same Stasis app
; the OBi200 uses — no separate Hermes-side config needed.
;
; [from-trunk]
; exten => _X.,1,NoOp(Hermes: PSTN call to ${EXTEN} from ${CALLERID(num)})
;  same => n,Stasis(hermes)
;  same => n,Hangup()
